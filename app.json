{
  "expo": {
    "name": "PovesteaNoastra",
    "slug": "povesteanoastra",
    "scheme": "povesteanoastra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow PovesteaNoastra to access your contacts so you can import guests to invite."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PovesteaNoastra to access your photos.",
          "savePhotosPermission": "Allow PovesteaNoastra to save the event album photos to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 257,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EC",
          "android": {
            "drawable": {
              "icon": "./assets/splash-icon-android.xml"
            }
          },
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#F7F3EC"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PovesteaNoastra folosește locația ta doar ca să alegi pe hartă locul evenimentului."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6A61D1"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.povesteanoastra.app",
      "associatedDomains": [
        "applinks:events-web-henna.vercel.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "PovesteaNoastra folosește camera pentru poze și pentru transmisia live a evenimentului.",
        "NSMicrophoneUsageDescription": "PovesteaNoastra folosește microfonul pentru sunetul transmisiei live."
      }
    },
    "android": {
      "package": "com.povesteanoastra.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E1A30",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "events-web-henna.vercel.app",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0932c4e-fbcf-4852-b2b7-b88b13e9415d"
      }
    },
    "owner": "sva4296"
  }
}
