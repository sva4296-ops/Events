<?xml version="1.0" encoding="utf-8"?>
<!--
  Android native splash mark. Same geometry and colors as utils/brandMark.ts, 180dp wide
  on the 288dp splash icon canvas. Android 12+ clips the icon to a circle of about 110dp
  radius and shows a flat color outside it, so nothing here can reach the screen edges.

  An animated-vector on purpose, with an animation that changes nothing: Android 12+
  rasterizes a plain drawable into a small bitmap and scales it up, which looks
  pixelated. Animatable icons are drawn live, at full resolution.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <group
                android:name="mark"
                android:scaleX="1.8"
                android:scaleY="1.8"
                android:translateX="54"
                android:translateY="46.8">
                <path
                    android:pathData="M8 66C22 66 38 72 50 82C26 64 20 40 32 30C40 23 50 28 50 38C50 28 60 23 68 30C80 40 74 64 50 82C62 72 78 66 92 66"
                    android:strokeWidth="6.5"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:fillColor="#00000000">
                    <aapt:attr name="android:strokeColor">
                        <gradient
                            android:type="linear"
                            android:startX="0"
                            android:startY="0"
                            android:endX="100"
                            android:endY="0"
                            android:startColor="#EBCB8B"
                            android:centerColor="#D9B46A"
                            android:endColor="#C99A4B" />
                    </aapt:attr>
                </path>
                <path
                    android:pathData="M2 66a6 6 0 1 0 12 0a6 6 0 1 0 -12 0Z"
                    android:fillColor="#EBCB8B" />
                <path
                    android:pathData="M86 66a6 6 0 1 0 12 0a6 6 0 1 0 -12 0Z"
                    android:fillColor="#C99A4B" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1"
                android:propertyName="scaleX"
                android:valueFrom="1.8"
                android:valueTo="1.8"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
