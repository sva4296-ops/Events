# Copy to .env.local and fill in from your Supabase project settings → API.
# Both are read at build time by Expo; the anon key is publishable client-side.
# Without these, the app runs in local-identity fallback mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Dev-only, for scripts/reset-test-data.js. Deliberately NOT prefixed with
# EXPO_PUBLIC_ — this key bypasses RLS entirely and must never be bundled into
# the app or committed. From Supabase project settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
