{
  "expo": {
    "name": "PovesteaNoastra",
    "slug": "povesteanoastra",
    "scheme": "povesteanoastra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow PovesteaNoastra to access your contacts so you can import guests to invite."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F1",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1E1A30"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.povesteanoastra.app"
    },
    "android": {
      "package": "com.povesteanoastra.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0932c4e-fbcf-4852-b2b7-b88b13e9415d"
      }
    },
    "owner": "sva4296"
  }
}
